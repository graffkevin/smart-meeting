{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Meeting",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/shutdown": {
      "post": {
        "summary": "Shutdown",
        "description": "Quit button: finish the current recording's transcription, then stop the server\n(the launcher then stops the Ollama it started).",
        "operationId": "shutdown",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/ai/restart": {
      "post": {
        "summary": "Restart Ai",
        "description": "Restart the local AI (Ollama), and install its model again if it is missing.",
        "operationId": "restart_ai",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/preferences": {
      "get": {
        "summary": "Get Preferences",
        "operationId": "get_preferences",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update Preferences",
        "description": "Saved and applied at once: name and vocabulary for the next sentences, defaults for the next\nmeeting.",
        "operationId": "update_preferences",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preferences"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/audio/devices": {
      "get": {
        "summary": "Audio Devices",
        "operationId": "audio_devices",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AudioDevices"
                }
              }
            }
          }
        }
      }
    },
    "/api/meetings": {
      "get": {
        "summary": "List Meetings",
        "description": "History, newest first; `q` searches titles, summaries and transcripts.",
        "operationId": "list_meetings",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MeetingListItem"
                  },
                  "title": "Response List Meetings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Start Meeting",
        "operationId": "start_meeting",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartMeetingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meeting"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/meetings/import": {
      "post": {
        "summary": "Import Meeting",
        "description": "Upload an audio or video file to transcribe and analyze. It is deleted once decoded.",
        "operationId": "import_meeting",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_import_meeting"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meeting"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/meetings/{meeting_id}": {
      "get": {
        "summary": "Get Meeting",
        "operationId": "get_meeting",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Meeting Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeetingDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update Meeting",
        "operationId": "update_meeting",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Meeting Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeetingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meeting"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Meeting",
        "operationId": "delete_meeting",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Meeting Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/meetings/{meeting_id}/tags": {
      "put": {
        "summary": "Set Meeting Tags",
        "description": "Replaces the tags of a meeting (used to group the history).",
        "operationId": "set_meeting_tags",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Meeting Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TagsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meeting"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tags": {
      "get": {
        "summary": "List Tags",
        "description": "Every tag in use, most used first.",
        "operationId": "list_tags",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TagCount"
                  },
                  "type": "array",
                  "title": "Response List Tags"
                }
              }
            }
          }
        }
      }
    },
    "/api/meetings/{meeting_id}/stop": {
      "post": {
        "summary": "Stop Meeting",
        "operationId": "stop_meeting",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Meeting Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meeting"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/meetings/{meeting_id}/analyze": {
      "post": {
        "summary": "Analyze Meeting",
        "operationId": "analyze_meeting",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Meeting Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/meetings/{meeting_id}/ask": {
      "post": {
        "summary": "Ask Meeting",
        "description": "A question about the meeting (\"what do I have to do?\"), answered from its transcript by the\nlocal AI, during or after the meeting. Kept with the meeting.",
        "operationId": "ask_meeting",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Meeting Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskAnswer"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/questions/recent": {
      "get": {
        "summary": "Recent Questions",
        "description": "Questions asked lately in any meeting: suggestions of the question field.",
        "operationId": "recent_questions",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "title": "Response Recent Questions"
                }
              }
            }
          }
        }
      }
    },
    "/api/meetings/{meeting_id}/report.md": {
      "get": {
        "summary": "Meeting Report",
        "operationId": "meeting_report",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Meeting Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/meetings/{meeting_id}/audio": {
      "delete": {
        "summary": "Delete Audio",
        "operationId": "delete_audio",
        "parameters": [
          {
            "name": "meeting_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Meeting Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActionItem": {
        "properties": {
          "task": {
            "type": "string",
            "title": "Task",
            "description": "T\u00e2che \u00e0 r\u00e9aliser, formul\u00e9e bri\u00e8vement"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner",
            "description": "Personne explicitement d\u00e9sign\u00e9e comme responsable, sinon null"
          },
          "deadline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline",
            "description": "\u00c9ch\u00e9ance exactement telle que prononc\u00e9e dans la transcription, sinon null"
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote",
            "description": "Extrait exact de la transcription o\u00f9 l'action est mentionn\u00e9e"
          },
          "verified": {
            "type": "boolean",
            "title": "Verified",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "task",
          "owner",
          "deadline",
          "quote"
        ],
        "title": "ActionItem"
      },
      "AiEstimates": {
        "properties": {
          "ask_s": {
            "type": "number",
            "title": "Ask S"
          },
          "analysis_s": {
            "type": "number",
            "title": "Analysis S"
          }
        },
        "type": "object",
        "required": [
          "ask_s",
          "analysis_s"
        ],
        "title": "AiEstimates"
      },
      "AskAnswer": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "asked_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asked At"
          }
        },
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "title": "AskAnswer",
        "description": "A question to the local AI about a meeting and its answer, kept with the meeting."
      },
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "AudioDevice": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "is_default": {
            "type": "boolean",
            "title": "Is Default"
          }
        },
        "type": "object",
        "required": [
          "name",
          "description",
          "is_default"
        ],
        "title": "AudioDevice"
      },
      "AudioDevices": {
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/AudioDevice"
            },
            "type": "array",
            "title": "Sources"
          },
          "sinks": {
            "items": {
              "$ref": "#/components/schemas/AudioDevice"
            },
            "type": "array",
            "title": "Sinks"
          },
          "in_use_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "In Use Source"
          },
          "in_use_sink": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "In Use Sink"
          }
        },
        "type": "object",
        "required": [
          "sources",
          "sinks"
        ],
        "title": "AudioDevices"
      },
      "Body_import_meeting": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": ""
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "auto"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_import_meeting"
      },
      "CapturedDevice": {
        "properties": {
          "device": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device"
          },
          "auto": {
            "type": "boolean",
            "title": "Auto"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "device",
          "auto"
        ],
        "title": "CapturedDevice"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "whisper": {
            "type": "string",
            "enum": [
              "loading",
              "ready",
              "error"
            ],
            "title": "Whisper"
          },
          "whisper_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Whisper Detail"
          },
          "ollama": {
            "type": "boolean",
            "title": "Ollama"
          },
          "ollama_model": {
            "type": "string",
            "title": "Ollama Model"
          },
          "ollama_model_available": {
            "type": "boolean",
            "title": "Ollama Model Available"
          },
          "active_meeting_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Meeting Id"
          },
          "ui_open": {
            "type": "boolean",
            "title": "Ui Open",
            "default": false
          },
          "setup": {
            "items": {
              "$ref": "#/components/schemas/SetupStepInfo"
            },
            "type": "array",
            "title": "Setup",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "whisper",
          "whisper_detail",
          "ollama",
          "ollama_model",
          "ollama_model_available",
          "active_meeting_id"
        ],
        "title": "Health"
      },
      "Meeting": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "$ref": "#/components/schemas/MeetingStatus"
          },
          "started_at": {
            "type": "string",
            "title": "Started At"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ended At"
          },
          "mic_device": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mic Device"
          },
          "remote_device": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remote Device"
          },
          "keep_audio": {
            "type": "boolean",
            "title": "Keep Audio",
            "default": false
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "source_file": {
            "anyOf": [
              {
                "type": "string"
              },
