#!/usr/bin/env bash
# Smart Meeting launcher for Linux and macOS (used by the Linux desktop entry); `make run` does
# the same. Installs uv if needed; the app then checks the system, builds the interface and
# installs Ollama and the AI model itself. Ctrl+C, or the Quit button, stops everything.
set -euo pipefail

ROOT="$(dirname "$(readlink -f "$0")")"
export PATH="$HOME/.local/bin:$PATH"

if ! command -v uv >/dev/null; then
  echo "Smart Meeting : installation de uv…"
  curl -LsSf https://astral.sh/uv/install.sh | sh -s -- --quiet
fi

extras=()
command -v nvidia-smi >/dev/null && nvidia-smi -L >/dev/null 2>&1 && extras=(--extra cuda)
exec uv run --quiet --directory "$ROOT/backend" "${extras[@]}" smart-meeting "$@"
