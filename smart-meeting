#!/usr/bin/env bash
# Smart Meeting launcher, the same command everywhere: `./smart-meeting` on Linux and macOS (also
# used by the Linux desktop entry), `.\smart-meeting` on Windows (runs smart-meeting.cmd); `make run`
# does the same. Installs uv if needed; the app then checks the system, builds the interface and
# installs Ollama and the AI model itself. Ctrl+C, or the Quit button, stops everything.
set -euo pipefail

ROOT="$(dirname "$(readlink -f "$0")")"

# Git Bash or Cygwin on Windows: the Windows launcher does the same with the Windows tools.
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*) exec cmd.exe //c "$(cygpath -w "$ROOT/smart-meeting.cmd")" "$@" ;;
esac
export PATH="$HOME/.local/bin:$PATH"

if ! command -v uv >/dev/null; then
  echo "Smart Meeting : installation de uv…"
  curl -LsSf https://astral.sh/uv/install.sh | sh -s -- --quiet
fi

extras=()
command -v nvidia-smi >/dev/null && nvidia-smi -L >/dev/null 2>&1 && extras=(--extra cuda)
# ${extras[@]+...}: an empty array is "unbound" for the bash 3.2 of macOS under `set -u`
exec uv run --quiet --directory "$ROOT/backend" ${extras[@]+"${extras[@]}"} smart-meeting "$@"
