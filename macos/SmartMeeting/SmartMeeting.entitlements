<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime exceptions of the app and of its server (the process that captures the audio).
     Not sandboxed: the server installs and runs the local AI (Ollama). Python callbacks from native
     code (PortAudio, through cffi) need writable and executable memory. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
</dict>
</plist>
